# Test-env secret template — expert-work-test.deepaihealth.com.
#
# DO NOT ADD LLM PROVIDER API KEYS HERE. This deployment's LLM keys are
# managed through the sql_encrypted secret-store backend, pasted via the
# admin UI vault — never as a K8s Secret / env var (confirmed with the
# user 2026-07-29). If you're tempted to add an ANTHROPIC_API_KEY /
# OPENAI_API_KEY / etc. line below, stop — that's the wrong mechanism
# for this deployment.
#
# Fill in every FILL_ME below (RDS/Redis hosts are already real — see
# infra/k8s/base/secrets.example.yaml for what each key feeds and why
# it's a Secret rather than the ConfigMap). This is a plain dotenv file,
# not a Kustomize resource — nothing in kustomization.yaml references it.
# Never commit a filled-in copy.
#
# kubectl --from-env-file has no prefix filter, so split by prefix into
# the two Secrets these manifests actually reference
# (control-plane/deployment.yaml envFrom + keycloak/statefulset.yaml
# secretKeyRefs):
#
#   grep -E '^EXPERT_WORK_' secrets.env.example > /tmp/control-plane.env
#   kubectl create secret generic control-plane-secrets -n expert-work \
#     --from-env-file=/tmp/control-plane.env
#
#   grep -E '^(KEYCLOAK_|KC_DB_)' secrets.env.example > /tmp/keycloak.env
#   kubectl create secret generic keycloak-secrets -n expert-work \
#     --from-env-file=/tmp/keycloak.env
#
#   rm -f /tmp/control-plane.env /tmp/keycloak.env   # holds filled secrets

# ---------------------------------------------------- control-plane-secrets
# RDS host:port + db (expert_work_dev) are real; user/password are RDS
# credentials provisioned in PR-2 — fill both in.
EXPERT_WORK_DB_DSN=postgresql+asyncpg://expert_work_dev:FILL_ME@pgm-bp19o30qlb16v6w1.pg.rds.aliyuncs.com:5432/expert_work_dev
EXPERT_WORK_CHECKPOINTER_DSN=postgresql://expert_work_dev:FILL_ME@pgm-bp19o30qlb16v6w1.pg.rds.aliyuncs.com:5432/expert_work_dev
EXPERT_WORK_DB_URL=postgresql+psycopg://expert_work_dev:FILL_ME@pgm-bp19o30qlb16v6w1.pg.rds.aliyuncs.com:5432/expert_work_dev
# Aliyun Redis (community edition) — password-only AUTH, no username.
EXPERT_WORK_QUOTA_REDIS_URL=redis://:FILL_ME@r-bp123nqe025r0qvka2.redis.rds.aliyuncs.com:6379/0
EXPERT_WORK_SECRET_ENCRYPTION_KEY=FILL_ME
EXPERT_WORK_APIKEY_RATE_LIMIT_HMAC_SALT=FILL_ME
EXPERT_WORK_SETUP_TOKEN=FILL_ME
# W2-PR3: real Langfuse project keys — MUST equal the langfuse-secrets
# LANGFUSE_INIT_PROJECT_PUBLIC_KEY/SECRET_KEY below (same project), or
# control-plane trace ingest 401s. Generate as `pk-lf-<random>` /
# `sk-lf-<random>` (`openssl rand -hex 16` for the random part).
EXPERT_WORK_LANGFUSE_PUBLIC_KEY=FILL_ME
EXPERT_WORK_LANGFUSE_SECRET_KEY=FILL_ME
# Sandbox migration W1 — Agent Sandbox (E2B) access. Only read when
# EXPERT_WORK_SANDBOX_BACKEND=agent_sandbox (configmap-patch.yaml); the
# domain and template name are non-secret and live there.
#
# This is the `adminApiKey` configured on the cluster's
# ack-sandbox-manager component (console → 组件管理). The two must be
# byte-identical or every sandbox create gets 401 from the gateway.
# Rotating it means changing BOTH sides plus the
# EXPERT_WORK_SANDBOX_E2B_API_KEY GitHub secret that
# .github/workflows/sandbox-contract.yml uses.
EXPERT_WORK_SANDBOX_E2B_API_KEY=FILL_ME
# MUST equal EXPERT_WORK_CRED_PROXY_EGRESS_TOKEN_SECRET below — on this
# cluster the minter is AgentSandboxClient running inside control-plane
# and the verifier is credential-proxy, so the same HMAC key has to reach
# two different Secrets. A mismatch fails silently at boot and shows up
# as every sandbox egress request getting 407.
EXPERT_WORK_SANDBOX_EGRESS_TOKEN_SECRET=FILL_ME

# ---------------------------------------------------------- keycloak-secrets
KEYCLOAK_ADMIN=FILL_ME
KEYCLOAK_ADMIN_PASSWORD=FILL_ME
# RDS `keycloak` database (PR-2 creates it — see task-4 brief) —
# separate DB/user from expert_work_dev above. JDBC URL carries no
# credentials; those go in KC_DB_USERNAME / KC_DB_PASSWORD below.
KC_DB_URL=jdbc:postgresql://pgm-bp19o30qlb16v6w1.pg.rds.aliyuncs.com:5432/keycloak
KC_DB_USERNAME=FILL_ME
KC_DB_PASSWORD=FILL_ME

# ------------------------------------------- platform secrets (encrypted vault)
# This overlay runs EXPERT_WORK_SECRET_STORE_BACKEND=sql_encrypted
# (configmap-patch.yaml — local_dev's in-memory put() breaks under 2
# replicas), so the OSS keys and the Keycloak admin-client secret live in
# the Postgres-backed encrypted vault, NOT in the control-plane-secret-files
# dotenv Secret (that mount is only read by the local_dev backend and can
# stay empty/absent here). Seed the vault ONCE per fresh environment,
# BEFORE the first sql_encrypted pod can pass startup (it resolves the OSS
# refs in lifespan — empty vault ⇒ CrashLoopBackOff). Run the seeds from
# any pod with this env + DB access; on a brand-new stack that means a
# pod still running the local_dev backend, overriding the backend env
# per-process:
#
#   kubectl exec -n expert-work <pod> -- \
#     env EXPERT_WORK_SECRET_STORE_BACKEND=sql_encrypted \
#         EXPERT_WORK_KEYCLOAK_ADMIN_CLIENT_SECRET=<value> \
#     python -m control_plane.seed_keycloak_secret
#
# The OSS pair seeds through the same CLI's --name mode (PROD-5):
#   python -m control_plane.seed_keycloak_secret \
#     --name expert-work/platform/oss/access-key --value <AK>   (secret-key 同理)
# —— 完整开荒配方见 docs/runbooks/production-release.md §1.6。LLM
# provider keys are pasted through the admin UI as usual (they land in
# the same vault).

# ------------------------------------------------------ observability-secrets
# W2-PR3. Split + create (key name deliberately un-prefixed so the
# EXPERT_WORK_ grep above can't sweep it into control-plane-secrets):
#
#   grep -E '^GRAFANA_' secrets.env.example > /tmp/observability.env
#   kubectl create secret generic observability-secrets -n expert-work \
#     --from-env-file=/tmp/observability.env
GRAFANA_ADMIN_PASSWORD=FILL_ME

# ------------------------------------------------------------ langfuse-secrets
# W2-PR3. RDS/Redis hosts are the real instances above; `langfuse` DB +
# user are created by the deploy runbook (plan Task 5). Split + create:
#
#   grep -E '^(DATABASE_URL|SALT|ENCRYPTION_KEY|CLICKHOUSE_|REDIS_CONNECTION_STRING|LANGFUSE_|NEXTAUTH_SECRET)' \
#     secrets.env.example > /tmp/langfuse.env
#   kubectl create secret generic langfuse-secrets -n expert-work \
#     --from-env-file=/tmp/langfuse.env
DATABASE_URL=postgresql://langfuse:FILL_ME@pgm-bp19o30qlb16v6w1.pg.rds.aliyuncs.com:5432/langfuse
# `openssl rand -hex 32` for both; ENCRYPTION_KEY must be exactly 64 hex.
SALT=FILL_ME
ENCRYPTION_KEY=FILL_ME
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=FILL_ME
# Platform cloud Redis, DB 1 (DB 0 = platform quota/cache — decision
# 2026-07-31); same instance + password as EXPERT_WORK_QUOTA_REDIS_URL.
# HARD PREREQUISITE: the INSTANCE (not per-DB) must run
# maxmemory-policy=noeviction — Langfuse's queue lives here and any
# eviction silently drops traces (the compose stack keeps a dedicated
# Redis for exactly this reason). The 2026-07-28 Redis selection already
# mandates noeviction; verify at deploy time:
#   redis-cli -h <host> -a <password> CONFIG GET maxmemory-policy
REDIS_CONNECTION_STRING=redis://:FILL_ME@r-bp123nqe025r0qvka2.redis.rds.aliyuncs.com:6379/1
# Same RAM AK/SK pair the platform object store uses (same bucket,
# langfuse/ prefix) — from the encrypted vault seed, see PR-2 runbook.
LANGFUSE_S3_EVENT_UPLOAD_ACCESS_KEY_ID=FILL_ME
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=FILL_ME
# `openssl rand -base64 32`
NEXTAUTH_SECRET=FILL_ME
# MUST equal EXPERT_WORK_LANGFUSE_PUBLIC_KEY/SECRET_KEY above.
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=FILL_ME
LANGFUSE_INIT_PROJECT_SECRET_KEY=FILL_ME
# Must be a syntactically valid email or headless init silently fails.
LANGFUSE_INIT_USER_EMAIL=FILL_ME@example.com
LANGFUSE_INIT_USER_PASSWORD=FILL_ME

# --------------------------------------------------- credential-proxy-secrets
# Sandbox migration W1 Task 2. Create with:
#
#   grep -E '^EXPERT_WORK_CRED_PROXY_' secrets.env.example > /tmp/cred-proxy.env
#   kubectl create secret generic credential-proxy-secrets -n expert-work \
#     --from-env-file=/tmp/cred-proxy.env
#   rm -f /tmp/cred-proxy.env
#
# Same RDS instance/credentials as EXPERT_WORK_DB_DSN above — the proxy
# writes credential_proxy_audit + sandbox_egress_audit rows into the same
# database.
EXPERT_WORK_CRED_PROXY_DB_DSN=postgresql+asyncpg://expert_work_dev:FILL_ME@pgm-bp19o30qlb16v6w1.pg.rds.aliyuncs.com:5432/expert_work_dev
# `openssl rand -base64 32`. HMAC key for per-sandbox egress tokens: the
# sandbox side MINTS with it, this proxy VERIFIES with it. The two must be
# byte-identical or every sandbox egress request gets 407 — and nothing
# fails at boot to tell you, because neither side ever sees the other's
# value. Whoever mints must read the SAME value:
#   * local docker supervisor -> EXPERT_WORK_SANDBOX_EGRESS_TOKEN_SECRET
#   * this cluster            -> AgentSandboxClient inside control-plane,
#                                so control-plane-secrets needs it too
#                                (wired in W1 Task 7)
EXPERT_WORK_CRED_PROXY_EGRESS_TOKEN_SECRET=FILL_ME
