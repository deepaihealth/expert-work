# Production secret template — every value is a PROD_PLACEHOLDER_*
# stand-in (spec 拍板; prod isn't provisioned yet). Mirrors
# overlays/test/secrets.env.example structure and the same split-by-
# prefix `kubectl create secret --from-env-file` recipe — see that file.
#
# DO NOT ADD LLM PROVIDER API KEYS HERE — see overlays/test/
# secrets.env.example header for why (sql_encrypted vault + admin UI
# paste flow, not a K8s Secret, confirmed with the user 2026-07-29).
# Never commit a filled-in copy.

# ---------------------------------------------------- control-plane-secrets
EXPERT_WORK_DB_DSN=postgresql+asyncpg://PROD_PLACEHOLDER_DB_USER:PROD_PLACEHOLDER_DB_PASSWORD@PROD_PLACEHOLDER_RDS_HOST:5432/PROD_PLACEHOLDER_DB_NAME
EXPERT_WORK_CHECKPOINTER_DSN=postgresql://PROD_PLACEHOLDER_DB_USER:PROD_PLACEHOLDER_DB_PASSWORD@PROD_PLACEHOLDER_RDS_HOST:5432/PROD_PLACEHOLDER_DB_NAME
EXPERT_WORK_DB_URL=postgresql+psycopg://PROD_PLACEHOLDER_DB_USER:PROD_PLACEHOLDER_DB_PASSWORD@PROD_PLACEHOLDER_RDS_HOST:5432/PROD_PLACEHOLDER_DB_NAME
EXPERT_WORK_QUOTA_REDIS_URL=redis://:PROD_PLACEHOLDER_REDIS_PASSWORD@PROD_PLACEHOLDER_REDIS_HOST:6379/0
EXPERT_WORK_SECRET_ENCRYPTION_KEY=PROD_PLACEHOLDER_SECRET_ENCRYPTION_KEY
EXPERT_WORK_APIKEY_RATE_LIMIT_HMAC_SALT=PROD_PLACEHOLDER_APIKEY_RATE_LIMIT_HMAC_SALT
EXPERT_WORK_SETUP_TOKEN=PROD_PLACEHOLDER_SETUP_TOKEN
EXPERT_WORK_LANGFUSE_PUBLIC_KEY=PROD_PLACEHOLDER_LANGFUSE_PUBLIC_KEY
EXPERT_WORK_LANGFUSE_SECRET_KEY=PROD_PLACEHOLDER_LANGFUSE_SECRET_KEY

# ---------------------------------------------------------- keycloak-secrets
KEYCLOAK_ADMIN=PROD_PLACEHOLDER_KEYCLOAK_ADMIN
KEYCLOAK_ADMIN_PASSWORD=PROD_PLACEHOLDER_KEYCLOAK_ADMIN_PASSWORD
KC_DB_URL=jdbc:postgresql://PROD_PLACEHOLDER_RDS_HOST:5432/PROD_PLACEHOLDER_KC_DB_NAME
KC_DB_USERNAME=PROD_PLACEHOLDER_KC_DB_USERNAME
KC_DB_PASSWORD=PROD_PLACEHOLDER_KC_DB_PASSWORD
