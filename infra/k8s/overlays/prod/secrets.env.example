# Production secret template — PROD-5(2026-08-24)按 overlays/test/
# secrets.env.example 的全量键面重写(此前的骨架缺 langfuse / clickhouse /
# credential-proxy / egress token / grafana 共 15 键)。所有值是
# PROD_PLACEHOLDER_* / FILL_ME —— 开荒日按 docs/runbooks/production-release.md
# 逐段填。结构性说明(为什么每个键是 Secret、坑在哪)以 test 版为准,这里
# 只保留生产必须注意的差异点。
#
# DO NOT ADD LLM PROVIDER API KEYS HERE. LLM keys walk through the
# sql_encrypted vault via the admin UI — never a K8s Secret(拍板
# 2026-07-29,与 test 相同)。
#
# This is a plain dotenv file, not a Kustomize resource. Never commit a
# filled-in copy. Split by prefix into five dotenv Secrets —— 逐条命令在
# production-release.md §1.4(single source,别再抄一份到这里):
#
#   control-plane-secrets    ← ^EXPERT_WORK_ 且非 ^EXPERT_WORK_CRED_PROXY_
#   keycloak-secrets         ← ^(KEYCLOAK_|KC_DB_)
#   observability-secrets    ← ^GRAFANA_
#   langfuse-secrets         ← ^(DATABASE_URL|SALT|ENCRYPTION_KEY|CLICKHOUSE_|REDIS_CONNECTION_STRING|LANGFUSE_|NEXTAUTH_SECRET)
#   credential-proxy-secrets ← ^EXPERT_WORK_CRED_PROXY_
#
# 另有【三】个不走本文件的 Secret(production-release.md §1.4/§1.6):
#   control-plane-secret-files ← deployment 文件挂载,optional: false ——
#                                不建则 pod 卡 FailedMount;sql_encrypted 不读
#                                其内容,建成空的即可,但对象必须存在
#   wecom-alert-webhook        ← 企微告警 URL,见 infra/k8s/base/secrets.example.yaml(PROD-2)
#   (加密金库 seed)            ← OSS AK/SK + KC admin-client secret 进 sql_encrypted
#                                vault,见 production-release.md §1.6.1

# ---------------------------------------------------- control-plane-secrets
# 生产 RDS PG16:应用账号必须是【非 superuser】——RLS 拍板(2026-08-24)首发
# 书面接受单层 ORM 隔离,但账号建法要给日后 FORCE RLS 留门:普通账号 + 库 owner,
# 不给 superuser / bypassrls。
EXPERT_WORK_DB_DSN=postgresql+asyncpg://PROD_PLACEHOLDER_DB_USER:PROD_PLACEHOLDER_DB_PASSWORD@PROD_PLACEHOLDER_RDS_HOST:5432/PROD_PLACEHOLDER_DB_NAME
EXPERT_WORK_CHECKPOINTER_DSN=postgresql://PROD_PLACEHOLDER_DB_USER:PROD_PLACEHOLDER_DB_PASSWORD@PROD_PLACEHOLDER_RDS_HOST:5432/PROD_PLACEHOLDER_DB_NAME
EXPERT_WORK_DB_URL=postgresql+psycopg://PROD_PLACEHOLDER_DB_USER:PROD_PLACEHOLDER_DB_PASSWORD@PROD_PLACEHOLDER_RDS_HOST:5432/PROD_PLACEHOLDER_DB_NAME
# Aliyun Redis 社区版 7.0,实例级 maxmemory-policy=noeviction(选型拍板
# 2026-07-28)— password-only AUTH。DB 0 = 平台配额/缓存。
EXPERT_WORK_QUOTA_REDIS_URL=redis://:PROD_PLACEHOLDER_REDIS_PASSWORD@PROD_PLACEHOLDER_REDIS_HOST:6379/0
# `openssl rand -hex 32`。生产新铸,绝不复用 test 值。
EXPERT_WORK_SECRET_ENCRYPTION_KEY=FILL_ME
EXPERT_WORK_APIKEY_RATE_LIMIT_HMAC_SALT=FILL_ME
EXPERT_WORK_SETUP_TOKEN=FILL_ME
# 必须与下方 LANGFUSE_INIT_PROJECT_* 同值(同一 project),否则 trace 401。
EXPERT_WORK_LANGFUSE_PUBLIC_KEY=FILL_ME
EXPERT_WORK_LANGFUSE_SECRET_KEY=FILL_ME
# = prod 集群 ack-sandbox-manager 组件的 adminApiKey(控制台 → 组件管理),
# 两侧必须逐字节一致,否则 sandbox create 全 401。
EXPERT_WORK_SANDBOX_E2B_API_KEY=FILL_ME
# 必须与下方 EXPERT_WORK_CRED_PROXY_EGRESS_TOKEN_SECRET 同值(mint 在
# control-plane 内的 AgentSandboxClient,verify 在 credential-proxy),
# 不一致 = 沙箱出网全 407 且 boot 期无报错。`openssl rand -base64 32`。
EXPERT_WORK_SANDBOX_EGRESS_TOKEN_SECRET=FILL_ME

# ---------------------------------------------------------- keycloak-secrets
KEYCLOAK_ADMIN=FILL_ME
KEYCLOAK_ADMIN_PASSWORD=FILL_ME
# RDS `keycloak` 独立库 + 独立账号(与应用库分离,同 test 结构)。
KC_DB_URL=jdbc:postgresql://PROD_PLACEHOLDER_RDS_HOST:5432/keycloak
KC_DB_USERNAME=FILL_ME
KC_DB_PASSWORD=FILL_ME

# ------------------------------------------------------ observability-secrets
GRAFANA_ADMIN_PASSWORD=FILL_ME

# ------------------------------------------------------------ langfuse-secrets
# RDS `langfuse` 独立库 + 独立账号;Redis 同实例 DB 1(拍板 2026-07-31)。
# noeviction 是硬前提,部署时验证:
#   redis-cli -h <host> -a <password> CONFIG GET maxmemory-policy
DATABASE_URL=postgresql://langfuse:FILL_ME@PROD_PLACEHOLDER_RDS_HOST:5432/langfuse
# `openssl rand -hex 32` for both; ENCRYPTION_KEY must be exactly 64 hex.
SALT=FILL_ME
ENCRYPTION_KEY=FILL_ME
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=FILL_ME
REDIS_CONNECTION_STRING=redis://:PROD_PLACEHOLDER_REDIS_PASSWORD@PROD_PLACEHOLDER_REDIS_HOST:6379/1
# 与平台对象存储同 bucket 的 `langfuse/` 前缀,同一 RAM AK/SK。
LANGFUSE_S3_EVENT_UPLOAD_ACCESS_KEY_ID=FILL_ME
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=FILL_ME
# `openssl rand -base64 32`
NEXTAUTH_SECRET=FILL_ME
# 必须与上方 EXPERT_WORK_LANGFUSE_PUBLIC_KEY/SECRET_KEY 同值。
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=FILL_ME
LANGFUSE_INIT_PROJECT_SECRET_KEY=FILL_ME
# 必须是语法合法的邮箱,否则 headless init 静默失败。
LANGFUSE_INIT_USER_EMAIL=FILL_ME@example.com
LANGFUSE_INIT_USER_PASSWORD=FILL_ME

# --------------------------------------------------- credential-proxy-secrets
# 与 EXPERT_WORK_DB_DSN 同库同账号(audit 表同库)。
EXPERT_WORK_CRED_PROXY_DB_DSN=postgresql+asyncpg://PROD_PLACEHOLDER_DB_USER:PROD_PLACEHOLDER_DB_PASSWORD@PROD_PLACEHOLDER_RDS_HOST:5432/PROD_PLACEHOLDER_DB_NAME
# 必须与上方 EXPERT_WORK_SANDBOX_EGRESS_TOKEN_SECRET 同值(见该键注释)。
EXPERT_WORK_CRED_PROXY_EGRESS_TOKEN_SECRET=FILL_ME
# `openssl rand -base64 32`。代理 /admin 写入面的 bearer token(B-31 ②)。
# 不设**不等于**放开 —— 那些路由直接 503;只有等失效接线(B-31 ①)真的去调
# 它时才必须填。/admin/health 保持开放供探针使用。
EXPERT_WORK_CRED_PROXY_ADMIN_TOKEN=FILL_ME
