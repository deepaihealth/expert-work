  "description": "expert_work Admin UI — Stream H.1b production scaffold. Operator-facing SPA for platform / tenant administrators. See memory:admin-ui-design-baseline + memory:cross-tenant-admin.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
